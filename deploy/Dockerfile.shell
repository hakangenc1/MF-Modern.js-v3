# syntax=docker/dockerfile:1
#
# Shell build. Context is the REPO ROOT (not shell/) — unlike the four remotes.
# shell/src/styles.css does `@source "../../accounts/src"` (and payments/security/
# twofactor): Tailwind has to scan the sibling remotes' source to emit the
# utility classes their federated components use, since those components render
# into the shell's HTML with the shell's stylesheet. We recreate that sibling
# layout inside the image so the relative @source paths resolve.

FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV MODERNJS_DEPLOY=node
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable

ARG SHELL_ORIGIN=
ARG ACCOUNTS_ORIGIN=
ARG PAYMENTS_ORIGIN=
ARG SECURITY_ORIGIN=
ARG TWOFACTOR_ORIGIN=
ENV SHELL_ORIGIN=$SHELL_ORIGIN \
    ACCOUNTS_ORIGIN=$ACCOUNTS_ORIGIN \
    PAYMENTS_ORIGIN=$PAYMENTS_ORIGIN \
    SECURITY_ORIGIN=$SECURITY_ORIGIN \
    TWOFACTOR_ORIGIN=$TWOFACTOR_ORIGIN

COPY shell/package.json shell/pnpm-lock.yaml ./
COPY shell/patches ./patches
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY shell/ ./
# `@source "../../accounts/src"` from /app/src/styles.css resolves to /accounts/src.
COPY accounts/src  /accounts/src
COPY payments/src  /payments/src
COPY security/src  /security/src
COPY twofactor/src /twofactor/src

RUN pnpm run deploy

# ---- runtime ----
FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/.output ./.output
CMD ["node", ".output/index"]
