# Copy to deploy/.env and fill in. deploy/.env is gitignored.

# The wildcard base under which the five apps are published, WITHOUT scheme.
# The apps become shell.<BASE_DOMAIN>, accounts.<BASE_DOMAIN>, etc.
# With sslip.io you don't register anything — <ip-with-dots>.sslip.io just works.
BASE_DOMAIN=92.5.190.202.sslip.io

# HMAC key for the session cookie — MUST be the same for every app.
# Generate once:  openssl rand -hex 32
SESSION_SECRET=replace-me

# Scales the mock API's built-in artificial latency. 1 = full demo latency,
# 0 = instant, 0.3 (default) = fast (<500ms) with the streamed sections still
# visibly arriving a beat after the shell.
MOCK_LATENCY=0.3
